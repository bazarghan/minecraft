# Copy to .env on the Ubuntu host. Every angle-bracket value MUST be replaced.
MSM_DOMAIN=minecraft.example.com
POSTGRES_PASSWORD=<generate-a-unique-database-password>
MSM_SECRET_KEY=<generate-with-openssl-rand-hex-32>
MSM_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
MSM_PUBLIC_URL=https://minecraft.example.com
MSM_ENVIRONMENT=production
MSM_COOKIE_SECURE=true
MSM_DOCS_ENABLED=false
MSM_HOST_RESERVED_MEMORY_MB=2048
MSM_ALLOW_MEMORY_OVERCOMMIT=false
MSM_MAX_UPLOAD_MB=1024
MSM_MAX_EXTRACTED_MB=4096
MSM_MAX_ARCHIVE_FILES=20000
MSM_DOWNLOAD_TIMEOUT_SECONDS=60
MSM_MAX_REDIRECTS=3
MSM_DATA_ROOT=/srv/minecraft-manager/servers
MSM_MAP_ROOT=/srv/minecraft-manager/maps
MSM_BACKUP_ROOT=/srv/minecraft-manager/backups
DOCKER_GID=998

# Optional one-time bootstrap. Prefer the interactive command in the deployment guide.
# Remove both values immediately after the first successful startup.
# MSM_INITIAL_ADMIN_USERNAME=admin
# MSM_INITIAL_ADMIN_PASSWORD=<temporary-unique-password-at-least-12-characters>
